{
  "name": "acorde-composer",
  "version": "0.1.13",
  "description": "A cross-platform AI-assisted score editor for the acorde music engine.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "check:playground": "node --check src/playground/playground.js",
    "check:notation": "node scripts/validate-notation-coverage.cjs",
    "check:notation-roundtrip": "node scripts/verify-notation-roundtrip.cjs",
    "check:release-fixtures": "node scripts/validate-release-qa-fixtures.cjs",
    "check:performance-fixtures": "node scripts/validate-performance-benchmark.cjs",
    "check:performance-results": "node scripts/validate-performance-results.cjs",
    "check:cold-start-results": "node scripts/validate-cold-start-results.cjs",
    "check:playback-results": "node scripts/validate-playback-results.cjs",
    "check:render-results": "node scripts/validate-render-results.cjs",
    "build:playground": "node scripts/build-playground-wasm.cjs",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check src/app.js && node scripts/validate-notation-coverage.cjs && node scripts/verify-notation-roundtrip.cjs && node scripts/validate-release-qa-fixtures.cjs && node scripts/validate-performance-benchmark.cjs && node scripts/validate-performance-results.cjs && node scripts/validate-cold-start-results.cjs && node scripts/validate-playback-results.cjs && node scripts/validate-render-results.cjs && cargo check --manifest-path engine/Cargo.toml",
    "check:candidate": "node scripts/check-release-candidate.cjs",
    "check:candidate:json": "node scripts/check-release-candidate.cjs --json",
    "check:candidate:strict": "node scripts/check-release-candidate.cjs --json --strict-dependency",
    "test": "node --test electron/*.test.cjs",
    "pack": "node scripts/build-engine.cjs && electron-builder --dir && node scripts/create-release-artifact-manifest.cjs",
    "bench:engine": "node scripts/benchmark-engine.cjs",
    "bench:performance": "node scripts/run-performance-benchmark.cjs",
    "bench:cold-start": "node scripts/benchmark-cold-start.cjs",
    "bench:playback": "node scripts/benchmark-playback.cjs",
    "bench:render": "node scripts/benchmark-render-pipeline.cjs",
    "compare:performance": "node scripts/compare-performance-benchmark.cjs",
    "release:qa": "node scripts/run-release-qa.cjs",
    "release:qa:validate": "node scripts/validate-release-qa.cjs",
    "release:evidence:validate": "node scripts/validate-release-evidence.cjs",
    "release:evidence:refresh": "node scripts/refresh-release-evidence.cjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.acorde.composer",
    "productName": "Acorde Composer",
    "files": ["electron/**/*", "src/**/*", "package.json", "NOTICE.md", "README.md", "README_ja.md", "README_zh.md", "CHANGELOG.md"],
    "extraResources": [{ "from": "build/engine", "to": "engine" }],
    "mac": { "category": "public.app-category.music" },
    "win": { "target": "nsis" }
  }
}
